# voice daemon settings. Copy to .env (git-ignored) and edit.
# NO SECRETS ARE REQUIRED. There is no bot token, no API key, no chat surface.

# --- STT (faster-whisper / CTranslate2) ---
STT_ENGINE=whisper_ct2
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
# Default is int8_float16 in engines/whisper_ct2.py (1952 -> 992 MB model VRAM,
# ~9 % faster, same transcript on the bench corpus; unmeasured on real voice
# notes). See docs/bench-int8.md. .env overrides the code default.
# WHISPER_COMPUTE_TYPE=float16  # rollback
# Clips longer than this (seconds) use BatchedInferencePipeline (-17 % at 37 s).
WHISPER_BATCH_ABOVE_S=30
WHISPER_BATCH_SIZE=8
# Proper nouns wander between segments (Dobropillia/Dobropilya/...). Set to 1 to
# prepend a short prose initial_prompt naming the recurring places and people —
# a decode bias, not a lookup table, so keep it 50-80 tokens. Off by default.
# WHISPER_GAZETTEER=1
# Replaces the built-in gazetteer text (and implies WHISPER_GAZETTEER=1).
# WHISPER_INITIAL_PROMPT=

# --- TTS ---
# Kokoro-82M is the recommended default (chat replies and long reading).
# chatterbox stays installed for emotion control if you set TTS_ENGINE=chatterbox;
# piper is the zero-VRAM CPU fallback (TTS_ENGINE=piper, see PIPER_* below).
TTS_ENGINE=kokoro
TTS_DEVICE=cuda
# Chatterbox degrades past ~300 chars per generate() call; the daemon chunks at
# sentence boundaries.
VOICE_TTS_MAX_CHARS=300
# The first chunk is capped lower so time-to-first-audio stays < 1 s on long
# replies (each extra chunk costs ~150 ms of total time; 80 is the knee).
VOICE_TTS_FIRST_CHUNK_CHARS=80
# Per-request text cap; longer bodies get HTTP 400.
VOICE_TTS_MAX_TEXT_CHARS=4000

# --- spoken-text normalisation (applies to /tts and /tts/long) ---
# Expand markdown, symbols, units, money and percentages before the engine sees
# the text ("**Warm** at 21°C" -> "Warm at 21 degrees Celsius"). Set 0 to speak
# the request verbatim.
VOICE_NORMALIZE=1
# Silence between paragraphs, in seconds. It is real silence PCM, never a spoken
# word. 0 disables the pause.
VOICE_PARAGRAPH_PAUSE_S=0.45

# --- long-form jobs (POST /tts/long) ---
# Chapter audio lives here; it is a cache, not a library — TTL-swept, dropped on
# restart. Defaults to $XDG_CACHE_HOME/voice-bot/jobs.
# VOICE_JOBS_DIR=
# Finished jobs (and dirs orphaned by a restart) are removed past this age.
# VOICE_JOBS_TTL_S=86400
# Hard cap on jobs kept in memory; the oldest finished ones are evicted first.
# VOICE_JOBS_MAX=50
# How often the TTL sweep runs.
# VOICE_JOBS_SWEEP_S=900
# Per-job text cap. A book, not a chat reply — this is not VOICE_TTS_MAX_TEXT_CHARS.
# VOICE_LONG_MAX_TEXT_CHARS=2000000

# --- hermes-tts-long (the wrapper; read from the environment, not this file,
# --- unless you export them — kept here so the knobs are discoverable) ---
# Give up on a job after this long, cancelling it on the daemon.
# VOICE_LONG_TIMEOUT=1800
# Poll interval while a job runs.
# VOICE_LONG_POLL_S=2
# Emit [[audio_as_voice]] only if EVERY chapter is at or under this many seconds
# (chat-app voice bubbles cap ~1 min and the directive is message-global). 0 = never.
# VOICE_MAX_VOICE_S=60
# --auto-chapter default: split headingless extracted text at paragraph
# boundaries near this many chars (~4000 chars is ~4 minutes of speech).
# VOICE_AUTO_CHAPTER_CHARS=4000

# --- TTS: Kokoro (only read when TTS_ENGINE=kokoro) ---
# Voice pack; af_heart is the default reading voice. See the model's VOICES.md.
# KOKORO_VOICE=af_heart
# a = American English, b = British. Non-English packs need misaki[<lang>].
# KOKORO_LANG_CODE=a
# Voice packs preloaded at startup and offered by GET /voices; a `?voice=` id
# outside this list is a 400. Defaults to the lang_code's shortlist
# (a: af_heart,af_bella,am_michael). KOKORO_VOICE is always included.
# KOKORO_VOICES=af_heart,af_bella,am_michael
# Kokoro's own cap, in chars, ~= its 100-200 phoneme sweet spot at the measured
# 1.01 phonemes/char on the bench texts. Not Chatterbox's 300.
# KOKORO_MAX_CHARS=200
# KOKORO_SPEED=1.0

# --- TTS: Piper (only read when TTS_ENGINE=piper; CPU, no VRAM) ---
# Directory holding NAME.onnx + NAME.onnx.json voice pairs.
# PIPER_VOICE_DIR=~/piper-voices
# Default voice name (without .onnx); defaults to the first voice found.
# PIPER_VOICE=

# --- daemon ---
# both | stt | tts — which engines are resident. `both` is ~8-9 GB of 16.
VOICE_RESIDENT=both
VOICE_HOST=127.0.0.1
VOICE_PORT=9877
VOICE_OPUS_BITRATE=32k
# Run a dummy request through each engine after load (~1 s total) so the first
# real request is not the CUDA-kernel-compile one.
VOICE_WARMUP=1

# torch allocator; keep this, CTranslate2 and torch fragment each other.
PYTORCH_ALLOC_CONF=expandable_segments:True

# Optional: raises Hugging Face download rate limits on first model pull.
# HF_TOKEN=

# --- desk satellite relay (optional; satellite/relay.py) ---
# The relay is a separate process from the daemon. It binds loopback only; put a
# TLS-terminating reverse proxy in front of it if a satellite connects over a network.
SAT_RELAY_PORT=9878
# One "<device> <sha256(token)>" line per device; mint with scripts/satellite-token.
# A leading ~ is expanded to the home directory by the relay and the helper.
SAT_TOKENS_FILE=~/.config/voice-bot/satellite-tokens
# Hermes api_server (the brain the relay talks to).
HERMES_API_URL=http://127.0.0.1:8642
# The Hermes api_server key. Never commit a real value; only the relay holds it,
# the satellite never sees it.
HERMES_API_KEY=
# STT language for satellite turns. Pinned because auto-detect on short clips
# that mix languages can pick the wrong one; empty means auto-detect.
SAT_STT_LANGUAGE=en
# Give up on a Hermes run after this long, then stop it and report hermes_timeout.
SAT_HERMES_TIMEOUT_S=120
